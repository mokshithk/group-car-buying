# Supabase Cloud Project Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Gmail SMTP Portal Configuration (Local .env.local + Vercel Environment Variables)
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Server-Only OTP & Password Reset Configuration (Set in Vercel Environment Variables; never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OTP_SIGNING_SECRET=generate-a-long-random-secret-string
