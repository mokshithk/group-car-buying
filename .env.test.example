# Supabase Test Environment Configuration Example
# Copy this file to .env.test (which is gitignored) and fill in your test credentials.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 5 Dedicated Test Accounts (Create in Supabase Authentication -> Users with "Auto Confirm" enabled)
TEST_BUYER_A_EMAIL=
TEST_BUYER_A_PASSWORD=

TEST_BUYER_B_EMAIL=
TEST_BUYER_B_PASSWORD=

TEST_DEALER_A_EMAIL=
TEST_DEALER_A_PASSWORD=

TEST_DEALER_B_EMAIL=
TEST_DEALER_B_PASSWORD=

TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
